// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String   // Hashed password
  createdAt DateTime @default(now())
  resumes      Resume[]
  applications Application[]
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  extractedText String
  skills        String   @default("") // Comma separated skills
  uploadedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model Job {
  id             String   @id @default(cuid())
  title          String
  company        String
  description    String
  requiredSkills String   // Comma separated or JSON string
}

model Application {
  id           String   @id @default(cuid())
  userId       String
  company      String
  role         String
  status       String   // "Applied", "OA", "Interview", "HR", "Offer", "Rejected"
  applied_date DateTime @default(now())
  notes        String?
  user         User     @relation(fields: [userId], references: [id])
}

model KnowledgeDocument {
  id        String                 @id @default(cuid())
  category  String
  title     String
  content   String
  embedding Unsupported("vector(384)")?
}

